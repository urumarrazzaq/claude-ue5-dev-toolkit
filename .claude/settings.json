{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(git ls-files *)"
    ],
    "deny": [
      "Edit(**/*.uasset)",
      "Edit(**/*.umap)",
      "Edit(**/Binaries/**)",
      "Edit(**/Intermediate/**)",
      "Edit(**/DerivedDataCache/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ue5_safety_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
